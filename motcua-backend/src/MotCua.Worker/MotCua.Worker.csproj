  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MotCua.Infrastructure\MotCua.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
